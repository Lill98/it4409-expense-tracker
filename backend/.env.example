# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit file .env.

NODE_ENV=development
PORT=3001

# MongoDB Atlas — Project: it4409-20242149M
# Lấy chuỗi này ở Atlas: Cluster > Connect > Drivers
MONGO_URI=mongodb+srv://20242149M:<password>@cluster0.xxxxx.mongodb.net/it4409-db?retryWrites=true&w=majority

# Chuỗi bí mật để ký JWT. Sinh chuỗi mạnh bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=thay-bang-chuoi-random-that-dai
JWT_EXPIRES_IN=7d

# Cost factor của bcrypt. 10 là mức cân bằng giữa an toàn và tốc độ.
BCRYPT_ROUNDS=10

# Các origin được phép gọi API, phân tách bằng dấu phẩy.
# Khi deploy phải thêm domain thật của frontend vào đây.
CORS_ORIGINS=http://localhost:5173

# Số lớp reverse proxy đứng trước backend, dùng để lấy đúng IP client.
#   1 = chạy trực tiếp hoặc sau 1 lớp Nginx  (mặc định)
#   2 = sau cloudflared + Nginx (cách deploy bằng docker compose)
# Lưu ý: khi deploy bằng docker compose thì giá trị này do compose đặt,
# không đọc từ file này.
TRUST_PROXY=1
