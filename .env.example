# Cấu hình cho `docker compose` khi deploy lên VM.
# Sao chép thành `.env` NGAY TRÊN VM rồi điền giá trị thật.
# File `.env` đã nằm trong .gitignore — TUYỆT ĐỐI không commit.

# ---------------------------------------------------------------
# MongoDB (chạy trong container, không phơi ra Internet)
# ---------------------------------------------------------------
MONGO_ROOT_USERNAME=it4409
# Sinh mật khẩu mạnh:
#   openssl rand -base64 24 | tr -d '/+=' | head -c 24
MONGO_ROOT_PASSWORD=thay-bang-mat-khau-manh
MONGO_DB_NAME=it4409-db

# ---------------------------------------------------------------
# Backend
# ---------------------------------------------------------------
# Chuỗi bí mật ký JWT. Sinh bằng:
#   openssl rand -hex 48
JWT_SECRET=thay-bang-chuoi-random-that-dai
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------
# Cloudflare Tunnel
# ---------------------------------------------------------------
# Lấy ở Cloudflare Zero Trust > Networks > Tunnels > tunnel của bạn > Install
# connector. Token là chuỗi rất dài trong lệnh `cloudflared ... run --token <đây>`.
# Đây là bí mật: ai có token này cũng dựng được connector vào tunnel của bạn.
TUNNEL_TOKEN=

# Hostname công khai bạn đã gắn cho tunnel, KHÔNG có dấu / ở cuối.
# Dùng cho CORS allowlist. Ví dụ: https://it4409.example.com
PUBLIC_URL=https://thay-bang-domain-cua-ban
